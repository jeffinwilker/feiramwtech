# ==== Aplicação ====
PORT=3210
NODE_ENV=production
# Interface em que o app escuta. Padrão 127.0.0.1 (só local, sempre atrás do Nginx/proxy).
# Em Docker, use 0.0.0.0 (já definido no Dockerfile).
BIND_HOST=127.0.0.1

# Segredo para assinar a sessão do admin (troque por uma string aleatória grande)
SESSION_SECRET=troque-por-uma-string-bem-grande-e-aleatoria

# Sal para gerar o hash do IP de quem posta (anti-spam). Pode deixar vazio (usa o SESSION_SECRET)
IP_SALT=

# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha-admin

# ==== PostgreSQL (use um banco e usuario DEDICADOS, isolados do Evolution) ====
# Opção A: variáveis separadas
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mwtech
PGUSER=mwtech
PGPASSWORD=senha-forte-do-banco

# Opção B (alternativa): string única. Se preenchida, tem prioridade sobre as de cima.
# DATABASE_URL=postgres://mwtech:senha-forte-do-banco@127.0.0.1:5432/mwtech

# ==== Uploads ====
# Tamanho máximo por arquivo enviado (em MB)
MAX_UPLOAD_MB=50
# Pasta onde os jogos e fotos ficam salvos (relativa à raiz do projeto ou caminho absoluto)
STORAGE_DIR=./storage

# ==== Jogos ====
# (Recomendado em produção) origem separada para servir os jogos, ex.: https://jogos.seudominio.com
# Deixe vazio para servir no mesmo domínio, em /g. Um subdomínio próprio isola melhor o código enviado.
GAMES_ORIGIN=
